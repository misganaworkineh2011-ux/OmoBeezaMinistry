# Copy to .env.local and fill in. Never commit .env.local.

# Google Gemini API key for the website chat assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Gemini model to use (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Admin dashboard database (Neon Postgres connection string, "Pooled connection").
# Leave empty locally to use a built-in database stored in .data/ (dev only).
DATABASE_URL=

# Vercel Blob storage for dashboard uploads (photos, videos, documents).
# Added automatically when you connect a Blob store to the Vercel project:
# newer stores add BLOB_STORE_ID (+ BLOB_WEBHOOK_PUBLIC_KEY), older ones
# BLOB_READ_WRITE_TOKEN. Either works. Leave empty locally: uploads are saved
# in public/uploads/.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
