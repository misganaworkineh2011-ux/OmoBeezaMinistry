# Vercel Blob storage for dashboard uploads (photos, videos, documents).
# Added automatically when you connect a Blob store to the Vercel project:
# newer stores add BLOB_STORE_ID (+ BLOB_WEBHOOK_PUBLIC_KEY), older ones
# BLOB_READ_WRITE_TOKEN. Either works. Leave empty locally: uploads are saved
# in public/uploads/.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
