# Copy to .env.local and fill in. Never commit .env.local.

# Google Gemini API key for the website chat assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Gemini model to use (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Admin dashboard database (Neon Postgres connection string, "Pooled connection").
# Leave empty locally to use a built-in database stored in .data/ (dev only).
DATABASE_URL=

# Vercel Blob storage for dashboard uploads (photos, videos, documents).
# Added automatically when you connect a Blob store to the Vercel project:
# newer stores add BLOB_STORE_ID (+ BLOB_WEBHOOK_PUBLIC_KEY), older ones
# BLOB_READ_WRITE_TOKEN. Either works. Leave empty locally: uploads are saved
# in public/uploads/.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Email reminders for weekly donors (website sign-ups), through any SMTP server.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the Gmail address,
# SMTP_PASS=an app password (Google Account → Security → App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional, e.g. "Omo Beeza Ministry <omobeeza@gmail.com>" (defaults to SMTP_USER)
EMAIL_FROM=

# Secret for the daily reminder job (vercel.json → /api/cron/reminders).
# Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=

# Optional: the public address used in reminder links (defaults to the Vercel
# production domain).
# SITE_URL=https://omobeezaministry.com

# Telegram reminder bot: create it with @BotFather in Telegram (/newbot) and
# paste the token here. Then use "Connect the bot" in Dashboard → Giving & reminders.
TELEGRAM_BOT_TOKEN=

# Ministry Telegram account (optional): reaches donors who never pressed Start on
# the bot, by @username or phone. API ID/hash from https://my.telegram.org;
# the session from `npm run telegram-login`. Keep the session private.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
